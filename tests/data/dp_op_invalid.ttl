@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix ex:      <http://example.org/> .

# DP_INVALID_OBJ is unreachable dead code in ontolex-validator.py (every
# lemonDataProperty also has a lemonPropDomains entry, so the branch
# that would raise it is never reached) and so is not exercised here;
# see the comment in ontolex-shapes.ttl.
#
# OP_INVALID_OBJ *is* reachable, but only for lemon-namespaced
# predicates with no entry in lemonPropDomains, such as ontolex:concept
# (ontolex:sense, used below only to make entryA "checked", has a
# domain entry and so would never trigger OP_INVALID_OBJ itself).
ex:entryA a ontolex:LexicalEntry ;
    ontolex:canonicalForm ex:formA ;
    ontolex:sense ex:senseA ;
    ontolex:concept "not a URI" .

ex:formA ontolex:writtenRep "a"@en .

ex:senseA ontolex:reference ex:r1 .
